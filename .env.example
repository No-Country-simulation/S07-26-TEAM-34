# Copiar a .env (ignorado por git) y completar con valores reales.

# Postgres (Neon en producción). Si se omite, usa SQLite local (./benchmark.db).
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Opcional. Si no está seteada, el motor de interpretación usa el fallback
# determinista (doc §7 — el sistema nunca falla por ausencia de LLM).
GEMINI_API_KEY=
