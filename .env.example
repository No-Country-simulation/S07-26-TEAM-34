# Variables de entorno — copiar a .env y completar los valores reales
# El archivo .env NO se commitea (está en .gitignore)

# Base de datos (Neon en producción, SQLite en desarrollo local)
# Producción: postgresql://user:password@host/dbname
# Desarrollo: dejar vacío — usa SQLite automáticamente
DATABASE_URL=

# LLM (opcional — sin este valor el sistema usa el fallback determinista)
GEMINI_API_KEY=

# Ruta al cuestionario YAML (opcional — usa config/questionnaire.yaml por defecto)
# QUESTIONNAIRE_YAML=/ruta/personalizada/questionnaire.yaml
